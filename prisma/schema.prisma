generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model CaseStudy {
    id          String   @id @default(cuid())
    title       String
    slug        String   @unique
    client      String
    challenge   String
    solution    String
    results     String
    coverImage  String
    featured    Boolean  @default(false)
    publishedAt DateTime @default(now())
}

model Blog {
    id          String   @id @default(cuid())
    image       String
    title       String
    content     String
    description String
    keywords    String[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("blogs")
}
