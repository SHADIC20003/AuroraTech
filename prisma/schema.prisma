generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model CaseStudy {
    id             String   @id @default(cuid())
    title          String
    description    String
    content        String
    title_ar       String?
    description_ar String?
    content_ar     String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now())

    @@map("case_studies")
}

model Blog {
    id             String   @id @default(cuid())
    image          String
    title          String
    content        String
    description    String
    keywords       String[]
    title_ar       String?
    description_ar String?
    content_ar     String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@map("blogs")
}
